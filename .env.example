# Midas configuration. Copy to .env. Everything is optional: with no keys
# at all, Midas runs in demo mode (canned data, zero spend).

DATABASE_URL=sqlite:///midas.db

# --- model providers (any one enables real AI) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEMO_MODE=false

# --- data providers (all free tiers) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
FMP_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- autonomy ladder: 0, 1, or 2. Levels 3+ do not exist in this codebase. ---
AUTONOMY_LEVEL=0

# --- risk caps (percent of paper account equity unless noted) ---
PER_TRADE_RISK_PCT=1.0
MAX_PREMIUM_PCT_PER_TRADE=2.0
MAX_TOTAL_PREMIUM_PCT=10.0
DAILY_LOSS_LIMIT_PCT=3.0
WEEKLY_LOSS_LIMIT_PCT=6.0
MAX_OPEN_POSITIONS=8
MAX_POSITIONS_PER_SECTOR=3
MIN_DTE_AT_ENTRY=14
MIN_OPEN_INTEREST=200
MAX_BID_ASK_SPREAD_PCT=10.0

# --- AI spend ---
DAILY_SPEND_LIMIT_USD=10.0
PER_STAGE_COST_CEILING_USD=0.60

# --- universe ---
UNIVERSE=demo
WATCHLIST=

# Autopilot: weekdays when the monitor auto-runs screen+committees (e.g. mon,thu). Empty = manual.
AUTO_CYCLE_WEEKDAYS=

# Mirror equity paper orders to the real Alpaca paper account (true = default)
ALPACA_MIRROR_ORDERS=true

# Max committees per auto-cycle (top screener scores first)
AUTO_CYCLE_MAX_COMMITTEES=4

# Gap protection: max notional per position as % of equity
MAX_NOTIONAL_PCT_PER_TRADE=15.0

# Portfolio exposure budget: total open notional as % of equity
MAX_TOTAL_NOTIONAL_PCT=60.0

# Stop protection
BREAKEVEN_AT_R=1.0
TRAIL_LOOKBACK_DAYS=10
MAX_HOLDING_DAYS=21
ALPACA_STANDING_STOPS=true

# Auto-cycle only during US market hours
AUTO_CYCLE_MARKET_HOURS_ONLY=true
# Discovery: merge Alpaca most-actives/movers into each screen
DISCOVERY_ENABLED=true
DISCOVERY_TOP=10

# Premarket gap sweep: flag held tickers gapping this % for review at the open (0=off)
PREMARKET_GAP_ALERT_PCT=3.0

# Evidence integrity
REQUIRE_BROKER_FILLS=true
OPTION_SLIPPAGE_PCT=1.0
OPTION_FEE_PER_CONTRACT=0.65
MAX_SECTOR_NOTIONAL_PCT=35.0

# Mirror options (incl. mleg spreads) to the Alpaca paper account (needs options Level 3 for spreads)
ALPACA_MIRROR_OPTIONS=true
